{
    "name": "super-kernel/composer-source-reference-plugin",
    "description": "Deterministic source references for SuperKernel Composer path packages.",
    "type": "composer-plugin",
    "license": "MIT",
    "require": {
        "php": ">=8.4.27 <8.5",
        "composer-plugin-api": "^2.9"
    },
    "require-dev": {
        "composer/composer": "^2.10.3",
        "friendsofphp/php-cs-fixer": "^3.95.27",
        "phpunit/phpunit": "^13.4.3"
    },
    "autoload": {
        "psr-4": {
            "SuperKernel\\ComposerSourceReferencePlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SuperKernel\\ComposerSourceReferencePlugin\\Tests\\": "tests/"
        }
    },
    "extra": {
        "class": "SuperKernel\\ComposerSourceReferencePlugin\\Plugin"
    },
    "scripts": {
        "format": "@php vendor/bin/php-cs-fixer fix --show-progress=bar --no-ansi",
        "format:check": "@php vendor/bin/php-cs-fixer check --show-progress=bar --no-ansi --diff",
        "test": "@php vendor/bin/phpunit"
    }
}
